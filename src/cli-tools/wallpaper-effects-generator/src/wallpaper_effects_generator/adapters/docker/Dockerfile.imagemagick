FROM python:3.14-alpine AS base

RUN apk add --no-cache \
    imagemagick \
    imagemagick-jpeg \
    imagemagick-png \
    imagemagick-webp \
    gcc \
    g++ \
    musl-dev \
    python3-dev \
    libffi-dev

RUN adduser -D -u 1000 wallpaper

WORKDIR /app

RUN pip install --no-cache-dir uv

COPY --chown=wallpaper:wallpaper . /app

RUN uv pip install --system --no-cache -e /app

RUN mkdir -p /input /output && \
    chown -R wallpaper:wallpaper /input /output

USER wallpaper

ENTRYPOINT ["weg"]

CMD ["--help"]
