FROM python:3.14-alpine AS base

# The build context is this package's repo root (AD-5): every COPY path below
# is relative to it, and no sibling checkout is referenced. Shared libraries
# enter from the git tags uv.lock pins, so the stage needs uv + git + CA
# certificates; an unreachable pin fails the build closed.
RUN apk add --no-cache imagemagick imagemagick-jpeg imagemagick-webp \
    git ca-certificates && \
    pip install --no-cache-dir "uv==0.9.22"

RUN adduser -D -u 1000 wallpaper

WORKDIR /app

ENV UV_PROJECT_ENVIRONMENT=/opt/venv \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never

COPY pyproject.toml uv.lock ./
COPY src ./src

RUN uv sync --frozen --no-dev --no-editable

ENV PATH="/opt/venv/bin:$PATH"

RUN mkdir -p /input /output && \
    chown -R wallpaper:wallpaper /input /output

USER wallpaper

CMD ["weg", "--help"]
