FROM python:3.14-alpine AS base

# cli-output and config-assembler-engine are consumed from their pinned repo
# tags (S1/S2): the build needs git + CA certificates to fetch them (neither is
# an in-repo path).
RUN apk add --no-cache imagemagick imagemagick-jpeg imagemagick-webp \
    git ca-certificates

RUN adduser -D -u 1000 wallpaper

WORKDIR /app

COPY src/shared/oci-runtime /app/shared/oci-runtime
COPY src/cli-tools/wallpaper-effects-generator /app/wallpaper-effects-generator

RUN pip install --no-cache-dir \
    typer pyyaml rich pydantic \
    /app/shared/oci-runtime \
    "cli-output @ git+https://github.com/RandomGenericUsername/cli-output@v0.1.0" \
    "config-assembler-engine @ git+https://github.com/RandomGenericUsername/config-assembler-engine@v0.1.0" \
    /app/wallpaper-effects-generator

RUN mkdir -p /input /output && \
    chown -R wallpaper:wallpaper /input /output

USER wallpaper

CMD ["weg", "--help"]
