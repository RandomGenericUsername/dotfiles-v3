FROM python:3.14-slim
WORKDIR /app
# The build context is this package's repo root (AD-5): every COPY path below
# is relative to it, and no sibling checkout is referenced. Shared libraries
# enter from the git tags uv.lock pins, so the stage needs uv + git + CA
# certificates; an unreachable pin fails the build closed instead of resolving
# something newer.
RUN apt-get update && \
    apt-get install -y --no-install-recommends git ca-certificates && \
    rm -rf /var/lib/apt/lists/* && \
    pip install --no-cache-dir "uv==0.9.22"
ENV UV_PROJECT_ENVIRONMENT=/opt/venv \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never
COPY pyproject.toml uv.lock ./
COPY src ./src
RUN uv sync --frozen --no-dev --no-editable && \
    mkdir -p /home/csguser && chmod 777 /home/csguser
ENV PATH="/opt/venv/bin:$PATH" \
    HOME=/home/csguser
CMD ["sleep", "infinity"]
