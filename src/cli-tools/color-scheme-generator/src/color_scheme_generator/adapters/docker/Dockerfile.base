FROM python:3.14-slim
WORKDIR /app
COPY cli-tools/color-scheme-generator /app/csg
COPY shared/config-assembler-engine /app/config-assembler-engine
COPY shared/oci-runtime /app/oci-runtime
RUN pip install --no-cache-dir /app/config-assembler-engine /app/oci-runtime /app/csg && \
    mkdir -p /home/csguser && chmod 777 /home/csguser
ENV HOME=/home/csguser
CMD ["sleep", "infinity"]
