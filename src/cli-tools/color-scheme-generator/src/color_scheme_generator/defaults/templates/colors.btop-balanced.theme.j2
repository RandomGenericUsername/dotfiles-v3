{#- btop theme -- csg-balanced ------------------------------------------
     Middle of the difficulty dial. Identical to csg-minimal in every key
     EXCEPT temp_* and cached_*, which are forced to a semantic cool->warm
     ramp so that a rising reading is never cooler than a falling one.

     Why those two and not others: btop scales temp against the DETECTED
     maximum (Theme::g("temp").at(clamp(temp*100/temp_max, 0, 100))), so
     "warmer" here means "closer to this machine's ceiling" -- a relative
     reading that survives a wallpaper change. cached_* is power draw in
     watts and P-state, not cache, so it reads as a consumption metric and
     groups with used_*. cpu_* is left as a ramp slice here because high
     wattage / high load under work is normal rather than alarming; forcing
     it semantic is the loud end of the dial (csg-full).

     Palette note: colors[] is sorted ASCENDING BY LUMINANCE, so it is a
     ramp, NOT an ANSI palette. Adjacent duplicate stops are collapsed into
     `ramp`, then padded to nine entries so a degenerate palette can never
     index out of range.

     Self-contained on purpose: any extra *.j2 in this directory is
     catalog-scanned and would be rejected as an unknown ColorFormat, so
     there is no shared partial. Structural similarity between the three
     variants is maintained by review, and by the dial assertions in
     tests/unit/adapters/test_btop_theme_formats.py.
-#}
{%- set _ns = namespace(u=[]) -%}
{%- for c in colors -%}
{%- if _ns.u | length == 0 or c.hex != _ns.u[-1].hex -%}
{%- set _ = _ns.u.append(c) -%}
{%- endif -%}
{%- endfor -%}
{%- set _rp = namespace(v=_ns.u[:]) -%}
{%- for _i in range(9 - (_rp.v | length)) -%}
{%- set _ = _rp.v.append(_rp.v[-1]) -%}
{%- endfor -%}

{#- Semantic stops: rank the distinct palette stops by the CIELAB b* axis,
     which is the blue<->yellow ("cool" -> "warm") axis, and take the
     extremes plus whichever stop sits closest to their midpoint. Picking
     from the b*-sorted order is what makes the ramp monotonic BY
     CONSTRUCTION for any palette, instead of by luck of the indices. -#}
{%- set _sem = namespace(rows=[]) -%}
{%- for c in colors -%}
{%- if _sem.rows | length == 0 or _sem.rows[-1].hex != c.hex -%}
{%- set _r = c.rgb[0] / 255.0 -%}{%- set _g = c.rgb[1] / 255.0 -%}{%- set _b = c.rgb[2] / 255.0 -%}
{%- set _r = (_r / 12.92) if _r <= 0.04045 else (((_r + 0.055) / 1.055) ** 2.4) -%}
{%- set _g = (_g / 12.92) if _g <= 0.04045 else (((_g + 0.055) / 1.055) ** 2.4) -%}
{%- set _b = (_b / 12.92) if _b <= 0.04045 else (((_b + 0.055) / 1.055) ** 2.4) -%}
{%- set _Y = 0.2126 * _r + 0.7152 * _g + 0.0722 * _b -%}
{%- set _Z = (0.0193 * _r + 0.1192 * _g + 0.9505 * _b) / 1.08883 -%}
{%- set _fy = (_Y ** (1.0 / 3.0)) if _Y > 0.008856 else (7.787 * _Y + 16.0 / 116.0) -%}
{%- set _fz = (_Z ** (1.0 / 3.0)) if _Z > 0.008856 else (7.787 * _Z + 16.0 / 116.0) -%}
{%- set _ = _sem.rows.append({'hex': c.hex, 'b': 200.0 * (_fy - _fz)}) -%}
{%- endif -%}
{%- endfor -%}
{%- set _byb = _sem.rows | sort(attribute='b') -%}
{%- set _tgt = (_byb[0].b + _byb[-1].b) / 2.0 -%}
{%- set _pick = namespace(v=_byb[0], d=(_byb[0].b - _tgt) | abs) -%}
{%- for _e in _byb -%}
{%- if (_e.b - _tgt) | abs < _pick.d -%}
{%- set _pick.v = _e -%}
{%- set _pick.d = (_e.b - _tgt) | abs -%}
{%- endif -%}
{%- endfor -%}
{%- set _cool = _byb[0].hex -%}
{%- set _midi = _pick.v.hex -%}
{%- set _warm = _byb[-1].hex -%}

# btop theme generated by color-scheme-generator -- csg-balanced
# source-image: {{ source_image }}
# backend: {{ backend }}
# generated-at: {{ generated_at }}
# variant: csg-balanced (temp + power forced cool->warm, rest from the ramp)
#
# Gradients are keyed by WHAT btop paints with them, not by what the key is
# named: cached_* is power draw in watts and P-state, available_* is disk
# I/O activity, cpu_* is the workhorse (meter, GPU util, core graphs,
# enc/dec, battery). Room-left reads (free, available) and consumption reads
# (used, cached) are grouped so each colour carries a real meaning.

# -- base surface ---------------------------------------------------------
theme[main_bg]="{{ background.hex }}"
theme[main_fg]="{{ foreground.hex }}"
theme[title]="{{ foreground.hex }}"
theme[hi_fg]="{{ _rp.v[6].hex }}"
theme[selected_bg]="{{ _rp.v[3].hex }}"
theme[selected_fg]="{{ foreground.hex }}"
theme[inactive_fg]="{{ _rp.v[2].hex }}"
theme[graph_text]="{{ _rp.v[6].hex }}"
theme[meter_bg]="{{ _rp.v[1].hex }}"
theme[proc_misc]="{{ _rp.v[6].hex }}"

# -- box chrome: one shared dim stop so outlines never fight the data ------
theme[cpu_box]="{{ _rp.v[2].hex }}"
theme[mem_box]="{{ _rp.v[2].hex }}"
theme[net_box]="{{ _rp.v[2].hex }}"
theme[proc_box]="{{ _rp.v[2].hex }}"
theme[div_line]="{{ _rp.v[1].hex }}"

# -- process state (btop >= 1.4.6) ----------------------------------------
theme[proc_pause_bg]="{{ _rp.v[5].hex }}"
theme[proc_follow_bg]="{{ _rp.v[6].hex }}"
theme[proc_banner_bg]="{{ _rp.v[3].hex }}"
theme[proc_banner_fg]="{{ foreground.hex }}"
theme[followed_bg]="{{ _rp.v[6].hex }}"
theme[followed_fg]="{{ foreground.hex }}"

# -- gradients ------------------------------------------------------------
# temp: SEMANTIC cool->warm (relative to this machine's detected max temp)
theme[temp_start]="{{ _cool }}"
theme[temp_mid]="{{ _midi }}"
theme[temp_end]="{{ _warm }}"

# cpu: ramp
theme[cpu_start]="{{ _rp.v[1].hex }}"
theme[cpu_mid]="{{ _rp.v[4].hex }}"
theme[cpu_end]="{{ _rp.v[7].hex }}"

# free: ramp (room left)
theme[free_start]="{{ _rp.v[0].hex }}"
theme[free_mid]="{{ _rp.v[3].hex }}"
theme[free_end]="{{ _rp.v[6].hex }}"

# cached: SEMANTIC cool->warm (power draw in watts / P-state)
theme[cached_start]="{{ _cool }}"
theme[cached_mid]="{{ _midi }}"
theme[cached_end]="{{ _warm }}"

# available: ramp (disk I/O activity -- room left, grouped with free)
theme[available_start]="{{ _rp.v[0].hex }}"
theme[available_mid]="{{ _rp.v[3].hex }}"
theme[available_end]="{{ _rp.v[6].hex }}"

# used: ramp (memory/disk in use, GPU VRAM -- consumption)
theme[used_start]="{{ _rp.v[1].hex }}"
theme[used_mid]="{{ _rp.v[4].hex }}"
theme[used_end]="{{ _rp.v[7].hex }}"

# download: ramp, two-stop (throughput has no "more is brighter" reading)
theme[download_start]="{{ _rp.v[0].hex }}"
theme[download_mid]=""
theme[download_end]="{{ _rp.v[6].hex }}"

# upload: ramp, two-stop
theme[upload_start]="{{ _rp.v[0].hex }}"
theme[upload_mid]=""
theme[upload_end]="{{ _rp.v[6].hex }}"

# process: ramp
theme[process_start]="{{ _rp.v[1].hex }}"
theme[process_mid]="{{ _rp.v[4].hex }}"
theme[process_end]="{{ _rp.v[7].hex }}"