{#- btop theme -- csg-minimal -------------------------------------------
     Every gradient is a slice of the wallpaper luminance ramp. This is the
     quiet end of the difficulty dial: nothing is forced cool->warm, so the
     whole theme inherits whatever the wallpaper already decided.

     Palette note: colors[] is sorted ASCENDING BY LUMINANCE (every backend
     sorts by sum(rgb)), so it is a ramp, NOT an ANSI palette. Adjacent
     duplicate stops are collapsed below into `ramp`, which is then padded to
     nine entries so a degenerate palette can never index out of range.

     Self-contained on purpose: any extra *.j2 in this directory is
     catalog-scanned and would be rejected as an unknown ColorFormat, so
     there is no shared partial. Structural similarity between the three
     variants is maintained by review, and by the dial assertions in
     tests/unit/adapters/test_btop_theme_formats.py.
-#}
{%- set _ns = namespace(u=[]) -%}
{%- for c in colors -%}
{%- if _ns.u | length == 0 or c.hex != _ns.u[-1].hex -%}
{%- set _ = _ns.u.append(c) -%}
{%- endif -%}
{%- endfor -%}
{%- set _rp = namespace(v=_ns.u[:]) -%}
{%- for _i in range(9 - (_rp.v | length)) -%}
{%- set _ = _rp.v.append(_rp.v[-1]) -%}
{%- endfor -%}

# btop theme generated by color-scheme-generator -- csg-minimal
# source-image: {{ source_image }}
# backend: {{ backend }}
# generated-at: {{ generated_at }}
# variant: csg-minimal (every gradient is a wallpaper luminance slice)
#
# Gradients are keyed by WHAT btop paints with them, not by what the key is
# named: cached_* is power draw in watts and P-state, available_* is disk
# I/O activity, cpu_* is the workhorse (meter, GPU util, core graphs,
# enc/dec, battery). Room-left reads (free, available) and consumption reads
# (used, cached) are grouped so each colour carries a real meaning.

# -- base surface ---------------------------------------------------------
theme[main_bg]="{{ background.hex }}"
theme[main_fg]="{{ foreground.hex }}"
theme[title]="{{ foreground.hex }}"
theme[hi_fg]="{{ _rp.v[6].hex }}"
theme[selected_bg]="{{ _rp.v[3].hex }}"
theme[selected_fg]="{{ foreground.hex }}"
theme[inactive_fg]="{{ _rp.v[2].hex }}"
theme[graph_text]="{{ _rp.v[6].hex }}"
theme[meter_bg]="{{ _rp.v[1].hex }}"
theme[proc_misc]="{{ _rp.v[6].hex }}"

# -- box chrome: one shared dim stop so outlines never fight the data ------
theme[cpu_box]="{{ _rp.v[2].hex }}"
theme[mem_box]="{{ _rp.v[2].hex }}"
theme[net_box]="{{ _rp.v[2].hex }}"
theme[proc_box]="{{ _rp.v[2].hex }}"
theme[div_line]="{{ _rp.v[1].hex }}"

# -- process state (btop >= 1.4.6) ----------------------------------------
theme[proc_pause_bg]="{{ _rp.v[5].hex }}"
theme[proc_follow_bg]="{{ _rp.v[6].hex }}"
theme[proc_banner_bg]="{{ _rp.v[3].hex }}"
theme[proc_banner_fg]="{{ foreground.hex }}"
theme[followed_bg]="{{ _rp.v[6].hex }}"
theme[followed_fg]="{{ foreground.hex }}"

# -- gradients ------------------------------------------------------------
# temp: ramp
theme[temp_start]="{{ _rp.v[2].hex }}"
theme[temp_mid]="{{ _rp.v[5].hex }}"
theme[temp_end]="{{ _rp.v[8].hex }}"

# cpu: ramp
theme[cpu_start]="{{ _rp.v[1].hex }}"
theme[cpu_mid]="{{ _rp.v[4].hex }}"
theme[cpu_end]="{{ _rp.v[7].hex }}"

# free: ramp (room left)
theme[free_start]="{{ _rp.v[0].hex }}"
theme[free_mid]="{{ _rp.v[3].hex }}"
theme[free_end]="{{ _rp.v[6].hex }}"

# cached: ramp (power draw / P-state -- consumption, grouped with used)
theme[cached_start]="{{ _rp.v[1].hex }}"
theme[cached_mid]="{{ _rp.v[4].hex }}"
theme[cached_end]="{{ _rp.v[7].hex }}"

# available: ramp (disk I/O activity -- room left, grouped with free)
theme[available_start]="{{ _rp.v[0].hex }}"
theme[available_mid]="{{ _rp.v[3].hex }}"
theme[available_end]="{{ _rp.v[6].hex }}"

# used: ramp (memory/disk in use, GPU VRAM -- consumption)
theme[used_start]="{{ _rp.v[1].hex }}"
theme[used_mid]="{{ _rp.v[4].hex }}"
theme[used_end]="{{ _rp.v[7].hex }}"

# download: ramp, two-stop (throughput has no "more is brighter" reading)
theme[download_start]="{{ _rp.v[0].hex }}"
theme[download_mid]=""
theme[download_end]="{{ _rp.v[6].hex }}"

# upload: ramp, two-stop
theme[upload_start]="{{ _rp.v[0].hex }}"
theme[upload_mid]=""
theme[upload_end]="{{ _rp.v[6].hex }}"

# process: ramp
theme[process_start]="{{ _rp.v[1].hex }}"
theme[process_mid]="{{ _rp.v[4].hex }}"
theme[process_end]="{{ _rp.v[7].hex }}"