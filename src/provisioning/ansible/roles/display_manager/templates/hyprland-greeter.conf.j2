# Hyprland config that hosts the regreet graphical greeter (display_manager role).
#
# regreet is a GTK greeter that must run inside a Wayland compositor. This
# minimal Hyprland config starts regreet at startup; when the user logs in and
# the session begins, we exit Hyprland (hyprctl dispatch exit) so the real
# user session (also Hyprland) takes over. This is ReGreet's documented
# Hyprland greeter pattern (rharish101/ReGreet#Usage).
exec-once = regreet; hyprctl dispatch exit

misc {
    disable_hyprland_logo = true
    disable_splash_rendering = true
    disable_hyprland_guiutils_check = true
}
