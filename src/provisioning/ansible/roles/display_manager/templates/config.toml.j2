# greetd configuration (rendered by the display_manager role).
#
# default_session runs the greeter as the 'greeter' user. tuigreet prompts for
# username/password then launches the provided --cmd (hypr-session -> dbus-run-
# session -> Hyprland) AS THE LOGGED-IN USER. Because neither greetd nor
# tuigreet starts an Xorg server, there is no GPU grab to conflict with
# Hyprland's Wayland session (the freeze fix).
[terminal]
vt = 1

[default_session]
command = "tuigreet --time --greeting 'dotfiles' --cmd /usr/local/bin/hypr-session"
user = "{{ display_manager_greeter_user }}"
