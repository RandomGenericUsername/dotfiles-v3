[output]
directory = "{{ install_dir | trim }}/generated/palettes"
verbosity = 1
# Empty default_formats = "all formats": csg resolves every format present in
# the provisioned template catalog (csg generate falls back to the catalog when
# default_formats is empty). The provisioning CHAIN is unaffected — the
# default_palette role passes explicit -f conf -f gtk.css -f yaml (its contract
# set), so the chain still emits exactly the three consumed formats.
default_formats = []
overwrite = false
# apply_to_terminal: after an interactive `csg generate`, apply the generated
# colors.sequences to the live terminal (event-driven — no shell polling).
# Default true; applies only when a TTY and the sequences format was produced.
apply_to_terminal = true

[generation]
backend = "pywal"

[runtime]
mode = "container"

[container]
engine = "podman"
image_prefix = "csg"
image_tag = "latest"
timeout_seconds = 300
memory_limit = "512m"
mount_timeout_seconds = 30
