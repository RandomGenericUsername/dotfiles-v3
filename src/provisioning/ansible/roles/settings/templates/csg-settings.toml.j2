[output]
directory = "{{ install_dir | trim }}/generated/palettes"
verbosity = 1
default_formats = ["conf", "gtk.css", "yaml"]
overwrite = false

[generation]
backend = "pywal"

[runtime]
mode = "container"

[container]
engine = "podman"
image_prefix = "csg"
image_tag = "latest"
timeout_seconds = 300
memory_limit = "512m"
mount_timeout_seconds = 30
