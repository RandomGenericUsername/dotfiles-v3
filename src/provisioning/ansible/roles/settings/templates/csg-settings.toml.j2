[output]
directory = "{{ install_dir | trim }}/generated/palettes"
verbosity = 1
default_formats = ["json", "sh"]
overwrite = false

[generation]
backend = "pywal"

[runtime]
mode = "local"

[container]
engine = "docker"
image_prefix = "csg"
image_tag = "latest"
timeout_seconds = 300
memory_limit = "512m"
mount_timeout_seconds = 30
