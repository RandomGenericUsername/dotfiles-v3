[output]
# Epic 4 single-source: default output for MANUAL `csg generate` runs only
# (the runtime always passes COLORSCHEME__OUTPUT__DIRECTORY per render).
# Points at XDG cache lifetime — the old install-spine output tree is gone.
directory = "{{ settings_xdg_cache_home | trim }}/dotfiles/csg-output"
verbosity = 1
# Empty default_formats = "all formats": csg resolves every format present in
# the provisioned template catalog (csg generate falls back to the catalog when
# default_formats is empty).
default_formats = []
overwrite = false
# apply_to_terminal: after an interactive `csg generate`, apply the output
# colors.sequences to the live terminal (event-driven — no shell polling).
# Default true; applies only when a TTY and the sequences format was produced.
apply_to_terminal = true

[generation]
backend = "pywal"

[runtime]
mode = "container"

[container]
engine = "podman"
image_prefix = "csg"
image_tag = "latest"
timeout_seconds = 300
memory_limit = "512m"
mount_timeout_seconds = 30
