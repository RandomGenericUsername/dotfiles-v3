#!/usr/bin/env python3
import json
import re
import shlex
import shutil
import subprocess
import time
from datetime import datetime
from pathlib import Path


def which(name):
    return shutil.which(name)


def choose_backend():
    if which("gpu-screen-recorder"):
        return "gpu-screen-recorder"
    if which("wf-recorder"):
        return "wf-recorder"
    return None


def hyprland_json(command):
    result = subprocess.run(["hyprctl", "-j", command], capture_output=True, text=True, check=False)
    if result.returncode != 0:
        raise RuntimeError(result.stderr.strip() or f"hyprctl {command} failed")
    return json.loads(result.stdout)


def resolve_target(target):
    if target == "screen":
        monitors = hyprland_json("monitors")
        monitor = next((item for item in monitors if item.get("focused")), None)
        if not monitor:
            raise RuntimeError("unable to resolve the focused monitor")
        return monitor["name"]
    if target == "window":
        clients = hyprland_json("clients")
        active_workspace = hyprland_json("activeworkspace")
        focused_monitor = next(
            (item for item in hyprland_json("monitors") if item.get("focused")),
            None,
        )
        active_workspace_id = active_workspace.get("id")
        focused_monitor_id = (
            focused_monitor.get("id") if focused_monitor else None
        )
        boxes = []
        for client in clients:
            if not client.get("mapped") or client.get("hidden"):
                continue
            workspace = client.get("workspace") or {}
            if active_workspace_id is not None and workspace.get("id") != active_workspace_id:
                continue
            if focused_monitor_id is not None and client.get("monitor") != focused_monitor_id:
                continue
            x, y = client.get("at", [None, None])
            width, height = client.get("size", [None, None])
            if None in (x, y, width, height) or width <= 0 or height <= 0:
                continue
            title = client.get("title") or client.get("class") or "window"
            boxes.append(f"{x},{y} {width}x{height} {title}")
        if not boxes:
            raise RuntimeError("no visible windows available for selection")
        if len(boxes) == 1:
            position, dimensions, _ = boxes[0].split(maxsplit=2)
            return f"{position} {dimensions}"
        result = subprocess.run(
            ["slurp", "-r", "-f", "%x,%y %wx%h"],
            input="\n".join(boxes) + "\n",
            capture_output=True,
            text=True,
            check=False,
        )
        if result.returncode != 0:
            raise RuntimeError("window selection was cancelled")
        selection = result.stdout.strip()
        match = re.fullmatch(r"(-?\d+),(-?\d+)\s+(\d+)x(\d+)", selection)
        if not match:
            raise RuntimeError(f"invalid window geometry: {selection}")
        x, y, width, height = (int(value) for value in match.groups())
        return f"{x},{y} {width}x{height}"
    if target == "region":
        result = subprocess.run(["slurp"], capture_output=True, text=True, check=False)
        if result.returncode != 0:
            raise RuntimeError("region selection was cancelled")
        selection = result.stdout.strip()
        match = re.fullmatch(r"(-?\d+),(-?\d+)\s+(\d+)x(\d+)", selection)
        if not match:
            raise RuntimeError(f"invalid region geometry: {selection}")
        x, y, width, height = (int(value) for value in match.groups())
        return f"{width}x{height}+{x}+{y}"
    raise ValueError(f"unsupported target: {target}")


def resolve_window_geometry():
    window = hyprland_json("activewindow")
    x, y = window.get("at", [None, None])
    width, height = window.get("size", [None, None])
    if None in (x, y, width, height):
        raise RuntimeError("unable to resolve the focused window geometry")
    return f"{x},{y} {width}x{height}"


def screenshot(args):
    if args.delay:
        time.sleep(args.delay)
    output = str(Path(args.output).expanduser()) if args.output else None
    command = ["grim"]
    if args.format:
        command.extend(["-t", args.format])
    if args.target != "screen":
        geometry = resolve_target(args.target)
        if args.target == "region":
            width, height, x, y = re.fullmatch(r"(\d+)x(\d+)\+(-?\d+)\+(-?\d+)", geometry).groups()
            geometry = f"{x},{y} {width}x{height}"
        command.extend(["-g", geometry])
    if output:
        Path(output).parent.mkdir(parents=True, exist_ok=True)
        command.append(output)
    else:
        command.append("-")
    if output:
        result = subprocess.run(command, check=False)
    else:
        grim = subprocess.Popen(command, stdout=subprocess.PIPE)
        copy = subprocess.run(["wl-copy"], stdin=grim.stdout, check=False)
        grim.stdout.close()
        result_code = grim.wait()
        if result_code != 0 or copy.returncode != 0:
            return emit({"state": "error", "error": "screenshot failed"}, result_code or copy.returncode)
    if output and result.returncode != 0:
        return emit({"state": "error", "error": "screenshot failed"}, result.returncode)
    return emit({"state": "idle", "target": args.target, "output_path": output or "clipboard"}, 0)


def _build_recording_command(backend, target, args, output_path):
    if backend == "gpu-screen-recorder":
        if args.target in {"region", "window"}:
            if args.target == "window":
                x, y, width, height = re.fullmatch(r"(-?\d+),(-?\d+)\s+(\d+)x(\d+)", target).groups()
                target = f"{width}x{height}+{x}+{y}"
            command = [backend, "-w", "region", "-region", target]
        else:
            command = [backend, "-w", target]
        command.extend([
            "-c", args.format,
            "-f", str(args.fps),
            "-q", args.quality,
            "-fallback-cpu-encoding", "yes",
            "-o", output_path,
        ])
    else:
        command = [backend, "-f", output_path]
        if args.target != "screen":
            command.extend(["-g", target])
    return command


def start_recording(args):
    # The resident runtime host owns the recorder and serves hub Control;
    # this launcher only resolves the target and hands the exact recorder
    # argv to `dotfiles-runtime capture`. Retiring the old in-process
    # spawn/control path is what lets the bar's Control reach a real job.
    backend = choose_backend()
    if not backend:
        return emit({"state": "error", "error": "no recording backend installed"}, 1)

    output_path = args.output or str(
        Path.home() / "Videos" / "Recordings" /
        f"recording-{datetime.now().strftime('%Y%m%d-%H%M%S')}.mp4"
    )
    output_path = str(Path(output_path).expanduser())
    Path(output_path).parent.mkdir(parents=True, exist_ok=True)

    target = resolve_target(args.target)
    command = _build_recording_command(backend, target, args, output_path)
    runtime = shutil.which("dotfiles-runtime")
    if runtime is None:
        return emit({"state": "error", "error": "dotfiles-runtime not found on PATH"}, 1)
    subprocess.Popen(
        [runtime, "capture", "--backend", backend, "--command", shlex.join(command)],
        start_new_session=True,
    )
    return emit({
        "state": "recording",
        "backend": backend,
        "output_path": output_path,
        "target": args.target,
        "format": args.format,
    }, 0)


def emit(payload, return_code):
    print(json.dumps(payload, sort_keys=True))
    raise SystemExit(return_code)


def parse_args():
    import argparse

    parser = argparse.ArgumentParser(description="Capture launcher for AGS/Hyprland recording states.")
    subparsers = parser.add_subparsers(dest="command", required=True)

    start = subparsers.add_parser("start", help="start the resident recording host")
    start.add_argument("--output", default=None)
    start.add_argument("--target", default="screen")
    start.add_argument("--format", default="mp4")
    start.add_argument("--fps", type=int, default=60)
    start.add_argument("--quality", default="high")
    start.set_defaults(func=start_recording)

    shot = subparsers.add_parser("screenshot", help="capture a screenshot")
    shot.add_argument("--target", choices=["region", "screen", "window"], default="region")
    shot.add_argument("--output", default=None)
    shot.add_argument("--delay", type=int, default=0)
    shot.add_argument("--format", choices=["png", "jpeg"], default="png")
    shot.set_defaults(func=screenshot)

    return parser.parse_args()


def main():
    args = parse_args()
    try:
        args.func(args)
    except (OSError, RuntimeError, ValueError, json.JSONDecodeError) as error:
        emit({"state": "error", "error": str(error)}, 1)


if __name__ == "__main__":
    main()
