# btop theme generated by color-scheme-generator -- csg-balanced
# source-image: {{ source_image }}
# backend: {{ backend }}
# generated-at: {{ generated_at }}
# variant: csg-balanced (temp + power(forced cool->warm) over wallpaper ramp)
#
# Palette note: colors[] is sorted by luminance, NOT by ANSI index.
# u[] below refers to the distinct (deduplicated) ramp stops.


# -- base surface colors --------------------------------------------
theme[main_bg]="{{ background.hex }}"
theme[main_fg]="{{ foreground.hex }}"
theme[title]="{{ foreground.hex }}"
theme[hi_fg]="{{ uniq[6].hex }}"
theme[selected_bg]="{{ uniq[3].hex }}"
theme[selected_fg]="{{ foreground.hex }}"
theme[inactive_fg]="{{ uniq[2].hex }}"
theme[graph_text]="{{ uniq[6].hex }}"
theme[meter_bg]="{{ uniq[1].hex }}"
theme[proc_misc]="{{ uniq[6].hex }}"
theme[cpu_box]="{{ uniq[2].hex }}"
theme[mem_box]="{{ uniq[2].hex }}"
theme[net_box]="{{ uniq[2].hex }}"
theme[proc_box]="{{ uniq[2].hex }}"
theme[div_line]="{{ uniq[1].hex }}"

# -- process-state colors (btop >= 1.4.6) -----------------------------
theme[proc_pause_bg]="{{ uniq[5].hex }}"
theme[proc_follow_bg]="{{ uniq[6].hex }}"
theme[proc_banner_bg]="{{ uniq[3].hex }}"
theme[proc_banner_fg]="{{ foreground.hex }}"
theme[followed_bg]="{{ uniq[6].hex }}"
theme[followed_fg]="{{ foreground.hex }}"

# -- gradients -----------------------------------------------------------

# temp: SEMANTIC cool->warm
theme[temp_start]="{{ uniq[3].hex }}"
theme[temp_mid]="{{ uniq[5].hex }}"
theme[temp_end]="{{ uniq[7].hex }}"

# cpu: ramp
theme[cpu_start]="{{ uniq[1].hex }}"
theme[cpu_mid]="{{ uniq[4].hex }}"
theme[cpu_end]="{{ uniq[7].hex }}"

# free: ramp
theme[free_start]="{{ uniq[0].hex }}"
theme[free_mid]="{{ uniq[3].hex }}"
theme[free_end]="{{ uniq[6].hex }}"

# cached: SEMANTIC cool->warm
theme[cached_start]="{{ uniq[3].hex }}"
theme[cached_mid]="{{ uniq[5].hex }}"
theme[cached_end]="{{ uniq[7].hex }}"

# available: ramp
theme[available_start]="{{ uniq[0].hex }}"
theme[available_mid]="{{ uniq[3].hex }}"
theme[available_end]="{{ uniq[6].hex }}"

# used: ramp
theme[used_start]="{{ uniq[1].hex }}"
theme[used_mid]="{{ uniq[4].hex }}"
theme[used_end]="{{ uniq[7].hex }}"

# download: ramp
theme[download_start]="{{ uniq[0].hex }}"
theme[download_mid]=""
theme[download_end]="{{ uniq[6].hex }}"

# upload: ramp
theme[upload_start]="{{ uniq[0].hex }}"
theme[upload_mid]=""
theme[upload_end]="{{ uniq[6].hex }}"

# process: ramp
theme[process_start]="{{ uniq[1].hex }}"
theme[process_mid]="{{ uniq[4].hex }}"
theme[process_end]="{{ uniq[7].hex }}"
