@import "../colors.rasi"

configuration {
    modes: "drun";
    font: "JetBrainsMono Nerd Font 12";
    show-icons: true;
    display-drun: " ";
    drun-display-format: "{name}";
}

window {
    transparency: "real";
    location: center;
    width: 548px;
    /* Unified panel frame: same @color04 accent edge + 16px radius as the
     * GTK tools, so rofi and the AGS windows read as siblings (spec D1/D2). */
    border: 2px;
    border-color: @color04;
    background-color: @color01;
    padding: 2px;
    border-radius: 16px;
}

mainbox {
    background-color: @background;
    border-radius: 8px;
    padding: 18px 18px 14px;
    spacing: 21px;
}

inputbar {
    background-color: @color01;
    border-radius: 5px;
    padding: 9px 12px;
    spacing: 10px;
    children: [ icon-search, entry ];
}

/* Leading search affordance, matching the GTK tools: rofi 2.0.0's `icon`
 * widget renders the SAME ITR-themed ui-search.svg the AGS windows load
 * (resolveIcon("ui", "search")), so it recolours with the wallpaper too.
 * `~` is expanded by rofi (helper_get_theme_path → rofi_expand_path); the
 * `current/icons` symlink is repointed by the seeder on every palette swap. */
icon-search {
    expand: false;
    filename: "~/.local/state/dotfiles/current/icons/ui-search.svg";
    size: 18;
    vertical-align: 0.5;
    /* Force the glyph to the palette foreground (same colour as the entry
     * text) so it always contrasts the solid field, independent of how the
     * icon-contrast guard rendered the source SVG. */
    tint: @foreground;
}

entry {
    placeholder: "Search...";
    placeholder-color: @color07;
    text-color: @foreground;
}

* {
    normal-background: transparent;
    alternate-normal-background: transparent;
    alternate-normal-foreground: @foreground;
}

listview {
    lines: 8;
    spacing: 0;
    scrollbar: false;
    border: 0;
}

message {
    border: 0;
    padding: 0;
}

sidebar {
    border: 0;
}

element {
    height: 36px;
    border-radius: 5px;
    padding-left: 25px;
}

element-icon {
    size: 24px;
}

element selected.normal {
    background-color: @color10;
    text-color: @background;
}

element normal.normal {
    background-color: transparent;
    text-color: @foreground;
}

element alternate.normal {
    background-color: transparent;
    text-color: @foreground;
}
