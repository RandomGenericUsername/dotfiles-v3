@import "../colors.rasi"

configuration {
    modes: "drun";
    font: "JetBrainsMono Nerd Font 12";
    show-icons: true;
    display-drun: " ";
    drun-display-format: "{name}";
}

window {
    transparency: "real";
    location: center;
    width: 548px;
    border: 4px;
    border-color: @color04;
    background-color: @color01;
    padding: 2px;
    border-radius: 12px;
}

mainbox {
    background-color: @background;
    border-radius: 8px;
    padding: 18px 18px 14px;
    spacing: 21px;
}

inputbar {
    background-color: @color01;
    border-radius: 5px;
    padding: 9px 12px;
    spacing: 10px;
    children: [ prompt, entry ];
}

prompt {
    text-color: @color07;
    text: "";
}

entry {
    placeholder: "Search...";
    placeholder-color: @color07;
    text-color: @foreground;
}

* {
    normal-background: transparent;
    alternate-normal-background: transparent;
    alternate-normal-foreground: @foreground;
}

listview {
    lines: 8;
    spacing: 0;
    scrollbar: false;
    border: 0;
}

message {
    border: 0;
    padding: 0;
}

sidebar {
    border: 0;
}

element {
    height: 36px;
    border-radius: 5px;
    padding-left: 25px;
}

element-icon {
    size: 24px;
}

element selected.normal {
    background-color: @color10;
    text-color: @background;
}

element normal.normal {
    background-color: transparent;
    text-color: @foreground;
}

element alternate.normal {
    background-color: transparent;
    text-color: @foreground;
}
