#!/usr/bin/env bash
set -euo pipefail

repository="https://github.com/fedsfarm/gloview"
lock_dir="${XDG_RUNTIME_DIR:-/tmp}/dotfiles-gloview-activate.lock"

if ! mkdir "$lock_dir" 2>/dev/null; then
  exit 0
fi
trap 'rmdir "$lock_dir"' EXIT

for _ in $(seq 1 60); do
  if [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ] && hyprctl version >/dev/null 2>&1; then
    break
  fi
  sleep 1
done

if [ -z "${HYPRLAND_INSTANCE_SIGNATURE:-}" ] || ! hyprctl version >/dev/null 2>&1; then
  printf '%s\n' "gloview-activate: Hyprland IPC was not ready after 60 seconds" >&2
  exit 1
fi

hyprpm remove Hyprspace >/dev/null 2>&1 || true
hyprpm remove hyprexpo >/dev/null 2>&1 || true

if ! hyprpm list 2>&1 | grep -E -q 'Repository gloview|Plugin gloview'; then
  printf 'y\n' | hyprpm add "$repository"
fi

# Self-heal after Hyprland upgrades (unconditional): every Hyprland update
# invalidates the hyprpm headers AND the built plugin, and `hyprpm reload`
# refuses to load anything until `hyprpm update` re-syncs the headers and
# rebuilds stale plugins. The previous shape ran `update` only when the repo
# was missing, so the first Hyprland upgrade after install silently killed
# every gesture/keybind backed by GloView (provision-owned gesture config in
# dotfiles/config/hypr/{input,gloview}.lua). A fresh `update` is a cheap
# no-op, so run it on every login.
hyprpm update

hyprpm enable gloview
hyprpm reload
hyprctl reload

hyprpm list 2>&1 | grep -E -A2 'Repository gloview|Plugin gloview' | grep -q 'enabled:'
hyprctl plugin list 2>&1 | grep -qi gloview

state_home="${XDG_STATE_HOME:-$HOME/.local/state}"
mkdir -p "$state_home/dotfiles"
touch "$state_home/dotfiles/gloview-active"
