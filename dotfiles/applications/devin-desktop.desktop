[Desktop Entry]
Encoding=UTF-8
Name=Devin
GenericName=Text Editor
Comment=Devin Desktop — the editor formerly branded Windsurf.
# Repo-authoritative override of /usr/share/applications/devin-desktop.desktop.
# It shadows the packaged entry (XDG_DATA_HOME has higher priority) so rofi's
# drun mode launches Devin (Windsurf) Wayland-native on Hyprland instead of
# through XWayland. The packaged Exec is preserved; only the Ozone/Wayland flags
# are added. (Windsurf was rebranded Devin Desktop upstream; the logical
# provisioning key stays `windsurf`.)
Exec=/usr/bin/devin-desktop --enable-features=UseOzonePlatform,WaylandWindowDecorations --ozone-platform-hint=auto %F
Icon=devin-desktop
StartupNotify=false
Terminal=false
Type=Application
Categories=TextEditor;Development;IDE;
StartupWMClass=Devin
MimeType=application/x-devin-desktop-workspace;
Keywords=windsurf;devin;codeium;ai;ide;
