[Desktop Entry]
Encoding=UTF-8
Name=OpenAI Codex CLI
GenericName=AI coding agent
Comment=OpenAI Codex coding agent in your terminal.
# The OpenAI Codex CLI ships no desktop entry, so it is invisible to rofi's
# drun mode. This repo-authoritative entry makes it searchable and launches it
# in the provisioned terminal (kitty). Exec (not Terminal=true) is used so the
# launch does not depend on rofi's `-terminal` resolution.
Exec=kitty --title "OpenAI Codex CLI" codex
Icon=utilities-terminal
StartupNotify=false
Terminal=false
Type=Application
Categories=Development;TerminalEmulator;
Keywords=codex;openai;ai;cli;agent;
