[Desktop Entry]
Encoding=UTF-8
Name=Visual Studio Code
GenericName=Text Editor
Comment=Code Editing. Redefined.
# Repo-authoritative override of /usr/share/applications/code.desktop (shipped
# by the AUR visual-studio-code-bin package). It shadows the packaged entry
# (XDG_DATA_HOME has higher priority) so rofi's drun mode launches VS Code
# Wayland-native on Hyprland instead of through XWayland. The packaged Exec is
# preserved (the package's own launcher is /usr/bin/code, which the PKGBUILD
# rewrites the entry to); only the Ozone/Wayland flags are added.
Exec=/usr/bin/code --enable-features=UseOzonePlatform,WaylandWindowDecorations --ozone-platform-hint=auto %F
Icon=vscode
StartupNotify=false
Terminal=false
Type=Application
Categories=TextEditor;Development;IDE;
StartupWMClass=Code
MimeType=text/plain;inode/directory;application/x-code-workspace;
Keywords=vscode;code;editor;ide;
